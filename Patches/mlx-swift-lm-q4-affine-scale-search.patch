+/// Search nearby MLX affine-Q4 scales without changing the stored format.
+///
+/// MLX anchors its affine grid at the larger-magnitude edge (`bias`) and chooses a signed
+/// scale. `round(bias / scale)` is therefore the integer number of scale steps from that
+/// edge to zero. Searching nearby integers changes the scale while retaining the same
+/// anchored edge, packed 0...15 codes, scale dtype, affine bias, and decode kernel.
+///
+/// The ordinary MLX result initializes every group. A candidate replaces it only on a
+/// strict MSE improvement, which makes standard Q4 a per-group fallback and handles zero
+/// groups without a special output representation.
+public func q4AffineScaleSearchQuantized(
+    _ weight: MLXArray
+) -> (weight: MLXArray, scales: MLXArray, biases: MLXArray) {
+    precondition(
+        weight.dim(-1) % q4AffineScaleSearchGroupSize == 0,
+        "AffineScaleSearch-Q4 requires the input width to be divisible by 64")
+
+    let baseline = MLX.quantized(
+        weight,
+        groupSize: q4AffineScaleSearchGroupSize,
+        bits: q4AffineScaleSearchBits,
+        mode: .affine)
+    guard let baselineBiases = baseline.biases else {
+        preconditionFailure("MLX affine quantization did not return biases")
+    }
+
+    let groupCount = weight.size / q4AffineScaleSearchGroupSize
+    let wordsPerGroup = q4AffineScaleSearchGroupSize * q4AffineScaleSearchBits / 32
+    let codesPerWord = 32 / q4AffineScaleSearchBits
+    let grouped = weight.reshaped(groupCount, q4AffineScaleSearchGroupSize).asType(.float32)
+    let baselineScales = baseline.scales.reshaped(groupCount, 1).asType(.float32)
+    let biases = baselineBiases.reshaped(groupCount, 1).asType(.float32)
+
+    let shifts =
+        (MLXArray(0 ..< codesPerWord) * q4AffineScaleSearchBits)
+        .asType(.uint32)
+        .reshaped(1, 1, codesPerWord)
+    let baselineWords = baseline.wq.reshaped(groupCount, wordsPerGroup, 1)
+    let baselineCodes = MLX.bitwiseAnd(
+        baselineWords >> shifts, MLXArray(UInt32(15))
+    ).reshaped(groupCount, q4AffineScaleSearchGroupSize)
+    let baselineReconstruction = baselineCodes.asType(.float32) * baselineScales + biases
+
+    var bestError = MLX.mean(
+        MLX.square(grouped - baselineReconstruction), axis: -1, keepDims: true)
+    var bestWeight = baseline.wq.reshaped(groupCount, wordsPerGroup)
+    var bestScales = baselineScales
+    MLX.eval(bestError, bestWeight, bestScales)
+
+    let baselineQ0 = MLX.round(biases / baselineScales)
+    for offset in q4AffineScaleSearchOffsets where offset != 0 {
+        let candidateQ0 = baselineQ0 + Float(offset)
+        let validQ0 = candidateQ0 .< Float(0)
+        let safeQ0 = MLX.where(validQ0, candidateQ0, MLXArray(Float(-1)))
+
+        // Round-trip through the stored dtype before measuring error. This makes the
+        // search score the exact grid that safetensors and the runtime will consume.
+        let candidateScale = (biases / safeQ0).asType(weight.dtype).asType(.float32)
+        let valid = validQ0 .&& (MLX.abs(candidateScale) .> Float(0))
+        let safeScale = MLX.where(valid, candidateScale, baselineScales)
+        let candidateCodes = MLX.clip(
+            MLX.round((grouped - biases) / safeScale), min: 0, max: 15
+        ).asType(.uint32)
+        let candidateReconstruction = candidateCodes.asType(.float32) * safeScale + biases
+        let candidateError = MLX.mean(
+            MLX.square(grouped - candidateReconstruction), axis: -1, keepDims: true)
+        let improved = valid .&& (candidateError .< bestError)
+
+        let packedGroups = candidateCodes.reshaped(
+            groupCount, wordsPerGroup, codesPerWord)
+        let candidateWeight = MLX.sum(packedGroups << shifts, axis: -1).asType(.uint32)
+        bestWeight = MLX.where(improved, candidateWeight, bestWeight)
+        bestScales = MLX.where(improved, safeScale, bestScales)
+        bestError = MLX.where(improved, candidateError, bestError)
+
+        // Conversion is offline. Materializing after each candidate bounds the lazy graph
+        // and transient memory for Laguna's very large stacked expert tensors.
+        MLX.eval(bestError, bestWeight, bestScales)
+    }
+
+    return (
+        bestWeight.reshaped(baseline.wq.shape),
+        bestScales.reshaped(baseline.scales.shape).asType(weight.dtype),
+        baselineBiases
+    )
+}
