+// Function objects can be destroyed on a different thread from every trace.
+// Retain only weak cache handles globally so their constants can be released
+// at function destruction without keeping a thread's compiler cache alive.
+class CompileCacheRegistry {
+ public:
+  void add(const std::shared_ptr<CompileCache>& cache) {
+    std::lock_guard lock(mutex_);
+    prune_locked();
+    caches_.push_back(cache);
+  }
+
+  void prune() {
+    std::lock_guard lock(mutex_);
+    prune_locked();
+  }
+
+  std::vector<std::shared_ptr<CompileCache>> snapshot() {
+    std::vector<std::shared_ptr<CompileCache>> result;
+    std::lock_guard lock(mutex_);
+    prune_locked();
+    // Allocate before acquiring any strong cache references. If allocation
+    // fails, no final cache owner can be destroyed under the registry mutex.
+    result.reserve(caches_.size());
+    for (auto& weak : caches_) {
+      if (auto cache = weak.lock()) {
+        result.push_back(std::move(cache));
+      }
+    }
+    return result;
+  }
+
+ private:
+  void prune_locked() {
+    caches_.erase(
+        std::remove_if(caches_.begin(), caches_.end(),
+                       [](const auto& cache) { return cache.expired(); }),
+        caches_.end());
+  }
+
+  std::mutex mutex_;
+  std::vector<std::weak_ptr<CompileCache>> caches_;
+};
+
+CompileCacheRegistry& compile_cache_registry() {
+  // Process-lifetime weak metadata avoids static destruction ordering with
+  // Swift function objects and thread-local compiler caches.
+  static auto* registry = new CompileCacheRegistry;
+  return *registry;
+}
+
+struct ThreadCompileCache {
+  ThreadCompileCache() : cache(std::make_shared<CompileCache>()) {
+    compile_cache_registry().add(cache);
+  }
+
+  ~ThreadCompileCache() {
+    cache.reset();
+    compile_cache_registry().prune();
+  }
+
+  std::shared_ptr<CompileCache> cache;
+};
