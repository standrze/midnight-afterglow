+void compile_erase_all_threads(std::uintptr_t fun_id) {
+  // Release the registry lock before erasing entries or dropping graph owners.
+  // A caller must own the function lifetime, as for compile_erase(). Swift
+  // additionally holds evalLock until every erase completes so its address-
+  // based function ID cannot be reused by a newly allocated function.
+  auto caches = compile_cache_registry().snapshot();
+  for (auto& cache : caches) {
+    cache->erase(fun_id);
+  }
+}
