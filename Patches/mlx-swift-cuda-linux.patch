+    func cudaHostCXXPath(context: PluginContext) -> String {
+        let environment = ProcessInfo.processInfo.environment
+        let configuredCompiler: (name: String, path: String)?
+        if let path = environment["MLX_CUDA_HOST_CXX"] {
+            configuredCompiler = ("MLX_CUDA_HOST_CXX", path)
+        } else if let path = environment["CUDAHOSTCXX"] {
+            configuredCompiler = ("CUDAHOSTCXX", path)
+        } else {
+            configuredCompiler = nil
+        }
+
+        if let configuredCompiler {
+            guard configuredCompiler.path.hasPrefix("/") else {
+                fatalError("\(configuredCompiler.name) must be an absolute path")
+            }
+            var isDirectory = ObjCBool(false)
+            let exists = FileManager.default.fileExists(
+                atPath: configuredCompiler.path,
+                isDirectory: &isDirectory)
+            guard exists, !isDirectory.boolValue,
+                FileManager.default.isExecutableFile(atPath: configuredCompiler.path)
+            else {
+                fatalError(
+                    "\(configuredCompiler.name) must name an executable file: "
+                        + configuredCompiler.path)
+            }
+            return configuredCompiler.path
+        }
+
+        guard let clangUrl = try? context.tool(named: "clang++") else {
+            fatalError("clang++ not found")
+        }
+        return clangUrl.url.path
+    }
+
