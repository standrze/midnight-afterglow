 namespace mlx::core {
 
+// encuda compiles generated CUDA translation units separately from Cmlx.
+// Clang lowers Device's defaulted equality comparison in those units to this
+// namespace-level symbol, while the regular C++ build emits no definition.
+// Keep the bridge local to the MLX 0.32 Swift CUDA integration.
+bool operator==(const Device& lhs, const Device& rhs) {
+  return lhs.type == rhs.type && lhs.index == rhs.index;
+}
