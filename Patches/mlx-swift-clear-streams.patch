diff --git a/Source/MLX/Stream.swift b/Source/MLX/Stream.swift
--- a/Source/MLX/Stream.swift
+++ b/Source/MLX/Stream.swift
@@ -3,6 +3,18 @@
 import Cmlx
 import Foundation
 
+/// Synchronize and release MLX command encoders owned by the calling thread.
+///
+/// CUDA command encoders are thread-local and must be cleared before their
+/// creating thread exits. In particular, short-lived Linux/CUDA tools should
+/// call this before process return so cleanup runs while the CUDA driver is
+/// still available.
+public func clearStreams() {
+    _ = evalLock.withLock {
+        mlx_clear_streams()
+    }
+}
