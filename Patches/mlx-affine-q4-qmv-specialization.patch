+inline int affine_qmv_results_per_simdgroup(
+    bool fast,
+    int N,
+    int group_size,
+    int bits) {
+  if (!fast || group_size != 64 || bits != 4) {
+    return 4;
+  }
+
+  static int requested_results = env::get_var(
+      "MLX_METAL_AFFINE_QMV_RESULTS_PER_SIMDGROUP", 0);
+  static int minimum_output_size =
+      env::get_var("MLX_METAL_AFFINE_QMV_MIN_OUTPUTS", 0);
+  if ((requested_results == 2 || requested_results == 4 ||
+       requested_results == 8) &&
+      N >= minimum_output_size &&
+      N % (2 * requested_results) == 0) {
+    return requested_results;
+  }
+  return 4;
+}
