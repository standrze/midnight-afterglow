diff --git a/Source/Cmlx/mlx-swift-stream.cpp b/Source/Cmlx/mlx-swift-stream.cpp
new file mode 100644
index 0000000..784db57
--- /dev/null
+++ b/Source/Cmlx/mlx-swift-stream.cpp
@@ -0,0 +1,20 @@
+// Copyright © 2025 Apple Inc.
+
+// C entry points for mlx C++ APIs that `mlx-c` does not bind.
+// See include/mlx-swift-stream.h.
+
+#include "mlx/c/error.h"
+#include "mlx/c/private/device.h"
+#include "mlx/c/private/stream.h"
+
+#include "mlx-swift-stream.h"
+
+extern "C" mlx_stream mlx_swift_new_thread_unsafe_stream(mlx_device dev) {
+  try {
+    return mlx_stream_new_(
+        mlx::core::new_thread_unsafe_stream(mlx_device_get_(dev)));
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+  }
+  return mlx_stream_new_();
+}
