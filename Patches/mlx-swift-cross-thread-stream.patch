+    /// As of mlx v0.31.2 streams are thread affine: a stream's GPU command encoder is
+    /// registered in a `thread_local` map, so evaluating on a stream from a thread other
+    /// than the one that created it raises "There is no Stream(gpu, N) in current thread."
+    /// mlx-swift hands `Stream` values around freely -- they back ``StreamOrDevice/default``
+    /// and are captured by `Task`s -- so it uses mlx's `new_thread_unsafe_stream`, which
+    /// registers the encoder globally instead.
+    ///
+    /// mlx applies no synchronization to these streams; the caller must. mlx-swift
+    /// serializes all evaluation on `evalLock`, which is that condition.
+    static func newThreadUnsafeStream(_ device: Device) -> mlx_stream {
+        evalLock.withLock {
+            mlx_swift_new_thread_unsafe_stream(device.ctx)
+        }
