+++ b/Source/Cmlx/include/mlx-swift-stream.h
@@ -0,0 +1,41 @@
+/* Copyright © 2025 Apple Inc. */
+
+/*
+ * mlx-swift additions to the `Cmlx` module.
+ *
+ * These are C entry points for mlx C++ APIs that `mlx-c` does not (yet) bind.
+ * The implementation lives in `../mlx-swift-stream.cpp`.
+ */
+
+#ifndef MLX_SWIFT_STREAM_H
+#define MLX_SWIFT_STREAM_H
+
+#include "mlx/c/device.h"
+#include "mlx/c/stream.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Make a new stream on `dev` that can be used from any thread.
+ *
+ * As of mlx v0.31.2 streams are thread affine: a stream's GPU command encoder
+ * is registered in a `thread_local` map, so evaluating on a stream from a
+ * thread other than the one that created it raises
+ * "There is no Stream(gpu, N) in current thread."
+ *
+ * mlx exposes `new_thread_unsafe_stream` for language bindings that do their
+ * own locking (mlx-swift serializes on `evalLock`) -- the stream may be passed
+ * between threads, but callers are responsible for ensuring there are no data
+ * races on it.
+ *
+ * The returned stream must be freed with `mlx_stream_free`.
+ */
+mlx_stream mlx_swift_new_thread_unsafe_stream(mlx_device dev);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
